# 留空时 Docker Compose 自动连接附带的 MySQL 容器；本地 pnpm dev 请填写本机 MySQL 地址
DATABASE_URL=
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_DATABASE=star_accounting
DB_USER=accounting
DB_PASSWORD=replace-with-a-strong-app-password
# Docker MySQL 仅绑定本机回环地址；默认使用 3307，避免与主机 MySQL 的 3306 冲突
MYSQL_HOST_PORT=3307
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# 用于无邮件找回密码、开启/关闭注册；至少 12 位，不能写入前端
ACCOUNT_ADMIN_KEY=replace-with-a-random-secret-at-least-12-characters
# API 数据库连接池（个人部署保持默认即可）
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=1
# 新部署使用 host 网络模式时监听所有网卡；建议通过 HTTPS 反向代理对外提供服务
API_HOST=0.0.0.0
