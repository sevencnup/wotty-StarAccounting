# Docker Compose 首次部署无需创建 .env；仅在自定义配置或本地 pnpm dev 时复制本文件。
# 留空时 Docker Compose 自动连接附带的 MySQL 容器；本地 pnpm dev 请填写本机 MySQL 地址。
DATABASE_URL=
# 仅首次建库或后端模型变更后设为 true；日常 pnpm dev 默认关闭以缩短远端 MySQL 启动时间
DB_AUTO_MIGRATE=false
# 设为 true 可预编译所有 Web 标签页；日常开发默认关闭，以保持启动输出简洁
DEV_PREWARM_ROUTES=false
# 以下密钥留空时，Compose 首次启动会自动生成并保存在 Docker 命名卷中。
# 若要自行指定，请在首次启动前填写；后续修改 .env 不会轮换已保存的密钥。
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=star_accounting
DB_USER=accounting
DB_PASSWORD=
# Docker MySQL 仅绑定本机回环地址；默认使用 3307，避免与主机 MySQL 的 3306 冲突
MYSQL_HOST_PORT=3307
JWT_SECRET=
# 用于无邮件找回密码、开启/关闭注册；至少 12 位，不能写入前端
ACCOUNT_ADMIN_KEY=
# API 数据库连接池（个人部署保持默认即可）
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=1
# 新部署使用 host 网络模式时监听所有网卡；建议通过 HTTPS 反向代理对外提供服务
API_HOST=0.0.0.0
API_PORT=12367
# Web 默认仅绑定宿主机回环地址 12366 端口；对外访问请配置反向代理。
WEB_HOST_PORT=12366
# Android APK 更新信息。Web 壳版与 KT 混合版的 APK 包名不同，下载地址必须分别配置。
APP_VERSION_CODE=
APP_VERSION_NAME=
APP_APK_URL=
APP_CHANGELOG=
APP_FORCE_UPDATE=false
APP_KTWEB_VERSION_CODE=
APP_KTWEB_VERSION_NAME=
APP_KTWEB_APK_URL=
APP_KTWEB_CHANGELOG=
APP_KTWEB_FORCE_UPDATE=false
