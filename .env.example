# MySQL 首次初始化配置
# 本地执行 pnpm dev 时使用；Docker Compose 会在容器内覆盖为 mysql 服务地址
DATABASE_URL=jdbc:mysql://127.0.0.1:3306/star_accounting
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_DATABASE=star_accounting
DB_USER=accounting
DB_PASSWORD=replace-with-a-strong-app-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# 用于无邮件找回密码、开启/关闭注册；至少 12 位，不能写入前端
ACCOUNT_ADMIN_KEY=replace-with-a-random-secret-at-least-12-characters
# AES-256-GCM 密钥：执行 `openssl rand -base64 32` 生成；启用后不能直接更换
DATA_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
# API 数据库连接池（个人部署保持默认即可）
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=1
