{
  "name": "wotty-staraccounting-server",
  "version": "2.3.74",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/main.js",
    "build": "node -e \"console.log('后端已切换为纯 Node.js，跳过 TypeScript 编译')\"",
    "start": "node --env-file-if-exists=.env src/main.js",
