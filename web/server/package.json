    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.19.1",
    "openai": "^6.32.0",
    "papaparse": "^5.5.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "prisma": "^6.16.1",
    "ssh2": "^1.17.0",
    "vitest": "^4.1.0"
  }
